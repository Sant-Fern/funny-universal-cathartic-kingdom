{
  "Id": "IamPolicyAutopilot",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:ConditionCheckItem",
        "dynamodb:DeleteItem",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:Query",
        "dynamodb:ReadDataForReplication",
        "dynamodb:UpdateItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-2:933605931561:table/pogo-results",
        "arn:aws:dynamodb:us-east-2:933605931561:table/pogo-results/index/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt"
      ],
      "Resource": [
        "arn:aws:kms:us-east-2:933605931561:key/*"
      ],
      "Condition": {
        "StringEquals": {
          "kms:ViaService": [
            "dynamodb.us-east-2.amazonaws.com"
          ]
        }
      }
    }
  ]
}
